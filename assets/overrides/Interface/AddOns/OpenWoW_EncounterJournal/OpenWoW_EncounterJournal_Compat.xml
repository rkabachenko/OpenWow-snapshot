            <Anchors><Anchor point="TOPLEFT" x="0" y="17"/><Anchor point="BOTTOMRIGHT" x="0" y="-17"/></Anchors>
            <Color r="0" g="0" b="0" a="1"/>
        </Texture></Layer></Layers>
        <Frames>
            <Button name="$parentScrollUpButton" inherits="UIPanelScrollUpButtonTemplate">
                <Anchors><Anchor point="TOP" x="0" y="15"/></Anchors>
                <Scripts><OnClick>local parent = self:GetParent(); local scrollStep = parent.scrollStep or (parent:GetHeight() / 2); parent:SetValue(parent:GetValue() - scrollStep); PlaySound("UChatScrollButton");</OnClick></Scripts>
            </Button>
            <Button name="$parentScrollDownButton" inherits="UIPanelScrollDownButtonTemplate">
                <Anchors><Anchor point="BOTTOM" x="0" y="-15"/></Anchors>
                <Scripts><OnClick>local parent = self:GetParent(); local scrollStep = parent.scrollStep or (parent:GetHeight() / 2); parent:SetValue(parent:GetValue() + scrollStep); PlaySound("UChatScrollButton");</OnClick></Scripts>
            </Button>
        </Frames>
        <Scripts><OnValueChanged>self:GetParent():SetVerticalScroll(value);</OnValueChanged></Scripts>
        <ThumbTexture name="$parentThumbTexture" inherits="UIPanelScrollBarButton" file="Interface\Buttons\UI-ScrollBar-Knob">
            <Size x="18" y="24"/><TexCoords left="0.20" right="0.80" top="0.125" bottom="0.875"/>
