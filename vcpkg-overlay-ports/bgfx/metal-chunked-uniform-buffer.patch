+	ChunkedScratchBufferMtl::ChunkedScratchBufferMtl()
+		: m_frameIndex(0)
+		, m_chunkIndex(0)
+		, m_chunkOffset(0)
+	{
+	}
+
+	void ChunkedScratchBufferMtl::create()
+	{
+		for (uint32_t ii = 0; ii < BGFX_CONFIG_MAX_FRAME_LATENCY; ++ii)
+		{
+			addChunk(m_frames[ii]);
+		}
+	}
+
+	void ChunkedScratchBufferMtl::destroy()
+	{
+		for (uint32_t ii = 0; ii < BGFX_CONFIG_MAX_FRAME_LATENCY; ++ii)
+		{
+			Frame& frame = m_frames[ii];
+			for (stl::vector<ChunkMtl>::iterator it = frame.chunks.begin(), end = frame.chunks.end(); it != end; ++it)
+			{
+				MTL_RELEASE(it->buffer);
+			}
+			frame.chunks.clear();
+		}
+	}
+
+	void ChunkedScratchBufferMtl::begin(uint32_t _frameIndex)
+	{
+		BX_ASSERT(_frameIndex < BGFX_CONFIG_MAX_FRAME_LATENCY, "Invalid Metal frame-in-flight index %u.", _frameIndex);
+		m_frameIndex = _frameIndex;
+		m_chunkIndex = 0;
+		m_chunkOffset = 0;
+	}
+
+	void ChunkedScratchBufferMtl::addChunk(Frame& _frame)
+	{
+		ChunkMtl chunk;
+		chunk.buffer = s_renderMtl->m_device.newBufferWithLength(kUniformScratchChunkSize, 0);
+		BGFX_FATAL(NULL != chunk.buffer, Fatal::UnableToInitialize, "Unable to allocate Metal uniform scratch chunk.");
+		chunk.data = (uint8_t*)chunk.buffer.contents();
+		BGFX_FATAL(NULL != chunk.data, Fatal::UnableToInitialize, "Unable to map Metal uniform scratch chunk.");
+		_frame.chunks.push_back(chunk);
+	}
+
+	void ChunkedScratchBufferMtl::write(
+		  ChunkedScratchBufferOffset& _out
+		, const void* _vsData
+		, uint32_t _vsSize
+		, const void* _fsData
+		, uint32_t _fsSize
+		)
+	{
+		const bool stageSizesValid = _vsSize <= kUniformStageScratchSize
+			&& _fsSize <= kUniformStageScratchSize
+			;
+		if (!stageSizesValid)
+		{
+			BGFX_FATAL(
+				  false
+				, Fatal::InvalidShader
+				, "Metal shader constant buffer exceeds stage scratch capacity (vertex %u, fragment %u, capacity %u)."
+				, _vsSize
+				, _fsSize
+				, kUniformStageScratchSize
+				);
+			return;
+		}
+
+		const uint32_t vsSize = bx::strideAlign(_vsSize, kUniformScratchAlignment);
+		const uint32_t fsSize = bx::strideAlign(_fsSize, kUniformScratchAlignment);
+		const uint32_t size = vsSize + fsSize;
+		Frame& frame = m_frames[m_frameIndex];
+		ChunkMtl* chunk = &frame.chunks[m_chunkIndex];
+
+		if (size > chunk->buffer.length() || m_chunkOffset > chunk->buffer.length() - size)
+		{
+			++m_chunkIndex;
+			m_chunkOffset = 0;
+			if (m_chunkIndex == frame.chunks.size())
+			{
+				addChunk(frame);
+			}
+			chunk = &frame.chunks[m_chunkIndex];
+		}
+
+		BGFX_FATAL(size <= chunk->buffer.length(), Fatal::InvalidShader, "Metal uniform allocation exceeds scratch chunk.");
+		_out.buffer = chunk->buffer;
+		_out.offsets[0] = m_chunkOffset;
+		_out.offsets[1] = m_chunkOffset + vsSize;
+
+		if (NULL != _vsData && 0 != _vsSize)
+		{
+			bx::memCopy(&chunk->data[_out.offsets[0]], _vsData, _vsSize);
+		}
+		if (NULL != _fsData && 0 != _fsSize)
+		{
+			bx::memCopy(&chunk->data[_out.offsets[1]], _fsData, _fsSize);
+		}
+
+		m_chunkOffset += size;
+	}
