+	// Size of one shader constant register, the granularity uniform locations and
+	// counts are expressed in throughout the backends.
+	constexpr uint32_t kUniformRegisterSize = 16;
+
+	// Uniform payloads are g_uniformTypeSize[type]*num bytes: 4 for Sampler, 16 for
+	// Vec4, 36 for Mat3, 64 for Mat4, and the opcodes framing them are 4 bytes each.
+	// At or below one Mat4 the copy is entirely overhead-bound, so it is done inline;
+	// above it the CRT's vectorized memmove is the better trade.
+	constexpr uint32_t kUniformInlineCopyMaxBytes = 64;
+
+	// bx::memCopy is an out-of-line symbol in the bx library (bx/src/bx.cpp:116) whose
+	// whole body is a tail call to ::memcpy, so every uniform store leaves the calling
+	// translation unit and lands in the CRT's memmove: a cross-library call plus
+	// memmove's own size dispatch, to move 4..64 bytes. The tail call is also why
+	// bx::memCopy never appears in sampled stacks - the copies are attributed straight
+	// to their caller.
+	//
+	// That price is paid once per uniform per draw at several sites that no amount of
+	// application-side batching can thin out. On the submission side
+	// UniformBuffer::writeUniform emits an opcode and a value, two calls per
+	// bgfx::setUniform. On the render side UniformBuffer::read decodes one opcode per
+	// uniform, and each backend then stores the value into its own constant staging
+	// area for every draw, from a constant buffer built out of shader reflection at
+	// program creation rather than out of what the frame actually set.
+	//
+	// ::memcpy with a constant size is lowered to inline loads/stores by clang, gcc and
+	// msvc alike, and is free of the strict-aliasing question a fixed-size struct
+	// assignment would raise: neither end of these copies is guaranteed aligned.
+	// Semantics are ::memcpy's, exactly as bx::memCopy's are - callers already
+	// guarantee the ranges do not overlap - so the bytes moved are identical.
+	BX_FORCE_INLINE void uniformInlineCopy(void* _dst, const void* _src, uint32_t _numBytes)
+	{
+		if (_numBytes > kUniformInlineCopyMaxBytes)
+		{
+			bx::memCopy(_dst, _src, _numBytes);
+			return;
+		}
+
+		uint8_t*       dst = (uint8_t*)_dst;
+		const uint8_t* src = (const uint8_t*)_src;
+
+		uint32_t remaining = _numBytes;
+
+		while (remaining >= kUniformRegisterSize)
+		{
+			::memcpy(dst, src, kUniformRegisterSize);
+			dst       += kUniformRegisterSize;
+			src       += kUniformRegisterSize;
+			remaining -= kUniformRegisterSize;
+		}
+
+		// At most fifteen bytes are left. The tail is a straight-line ladder rather
+		// than a loop on purpose: a loop here is not provably short to the optimizer,
+		// which unrolls and vectorizes it into hundreds of bytes of never-taken code
+		// in a function that is inlined into the innermost draw loop.
+		if (remaining >= 8)
+		{
+			::memcpy(dst, src, 8);
+			dst       += 8;
+			src       += 8;
+			remaining -= 8;
+		}
+
+		if (remaining >= 4)
+		{
+			::memcpy(dst, src, 4);
+			dst       += 4;
+			src       += 4;
+			remaining -= 4;
+		}
+
+		// Every uniform payload size above is a multiple of four; these two keep the
+		// helper correct for any size - marker strings included - rather than relying
+		// on that.
+		if (remaining >= 2)
+		{
+			::memcpy(dst, src, 2);
+			dst       += 2;
+			src       += 2;
+			remaining -= 2;
+		}
+
+		if (remaining >= 1)
+		{
+			*dst = *src;
+		}
+	}
